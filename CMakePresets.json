{
  "version": 6,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}"
    },
    {
      "name": "linux-debug",
      "displayName": "Linux Debug (gcc, ASan/UBSan)",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "CATAGUI_SANITIZE": "ON" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
    },
    {
      "name": "linux-release",
      "displayName": "Linux Release (gcc)",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
    },
    {
      "name": "windows-debug",
      "displayName": "Windows Debug (llvm-mingw cross-compile from Linux/WSL)",
      "inherits": "base",
      "toolchainFile": "${sourceDir}/cmake/llvm-mingw.cmake",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
    },
    {
      "name": "windows-release",
      "displayName": "Windows Release (llvm-mingw cross-compile from Linux/WSL)",
      "inherits": "base",
      "toolchainFile": "${sourceDir}/cmake/llvm-mingw.cmake",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
    },
    {
      "name": "msys2-debug",
      "displayName": "Windows Debug (native, MSYS2 UCRT64 gcc)",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "CMAKE_C_COMPILER": "gcc" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "msys2-release",
      "displayName": "Windows Release (native, MSYS2 UCRT64 gcc)",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "CMAKE_C_COMPILER": "gcc" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    }
  ],
  "buildPresets": [
    { "name": "linux-debug", "configurePreset": "linux-debug" },
    { "name": "linux-release", "configurePreset": "linux-release" },
    { "name": "windows-debug", "configurePreset": "windows-debug" },
    { "name": "windows-release", "configurePreset": "windows-release" },
    { "name": "msys2-debug", "configurePreset": "msys2-debug" },
    { "name": "msys2-release", "configurePreset": "msys2-release" }
  ],
  "testPresets": [
    { "name": "linux-debug", "configurePreset": "linux-debug", "output": { "outputOnFailure": true }, "filter": { "exclude": { "label": "engine" } } },
    { "name": "msys2-debug", "configurePreset": "msys2-debug", "output": { "outputOnFailure": true }, "filter": { "exclude": { "label": "engine" } } }
  ]
}
