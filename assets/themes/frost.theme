# Frost — cool arctic blue-greys (after the Nord palette), a frosted board, flat stones.

extends = dark
name = Frost
dark = true

background.kind  = solid
board.style      = flat
board.line_width = 1.1
board.shadow     = false
stones.style     = flat
stones.shadow    = 0.2
shape.radius     = 8

