# Solar Dark — the same calm palette at night (after the Solarized dark palette).

extends = dark
name = Solar Dark
dark = true

background.kind  = solid
board.style      = flat
board.line_width = 1.0
board.shadow     = false
stones.style     = flat
stones.shadow    = 0.25
shape.radius     = 6

colors.background       = #002B36
colors.surface          = #073642
colors.surface_alt      = #0B4150
colors.border           = #174B59
colors.text             = #93A1A1
colors.text_muted       = #657B83
colors.accent           = #B58900
