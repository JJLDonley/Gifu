colors.hover            = #B589001F
colors.danger           = #DC322F
colors.board            = #0F4B5A
colors.board_line       = #93A1A1
colors.board_label      = #839496
colors.black_stone      = #001E26
colors.white_stone      = #EEE8D5
colors.black_stone_edge = #000F13
colors.white_stone_edge = #93A1A1
colors.last_move        = #DC322F
colors.winrate_black    = #001E26
colors.winrate_white    = #EEE8D5
colors.graph_line       = #B58900
colors.score_line       = #2AA198
colors.candidate_best   = #859900
colors.candidate_good   = #2AA198
colors.candidate_bad    = #DC322F
