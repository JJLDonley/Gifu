    "text_muted":      "#6E6E6E",
    "accent":          "#111111",
    "accent_text":     "#FFFFFF",
    "hover":           "#0000000F",
    "danger":          "#C62828",
    "board":           "#F1F1F1",
    "board_line":      "#2A2A2A",
    "board_label":     "#707070",
    "black_stone":     "#121212",
    "white_stone":     "#FFFFFF",
    "black_stone_edge":"#000000",
    "white_stone_edge":"#2A2A2A",
    "last_move":       "#E53935",
    "winrate_black":   "#111111",
