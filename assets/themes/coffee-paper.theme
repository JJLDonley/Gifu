# Coffee-stained paper — aged paper background with procedural coffee rings,
# translucent panels, board printed in ink on the same paper.

extends = cream
name = Coffee Paper

colors.background       = #E7D6B2
colors.surface          = #F3E6C9C8
colors.surface_alt      = #EADBB9B0
colors.border           = #C9B08399
colors.text             = #33251A
colors.text_muted       = #7A6248
colors.accent           = #6E4320
colors.accent_text      = #F8EEDB
colors.hover            = #6E43201A
colors.board            = #EEDFBF
colors.board_line       = #3B2A1C
colors.board_label      = #6E5539
colors.black_stone      = #2A2019
colors.white_stone      = #F8F0DE
colors.black_stone_edge = #18120D
colors.white_stone_edge = #3B2A1C
colors.last_move        = #A4282A
colors.graph_line       = #33251A
colors.score_line       = #9B6B3A

background.kind              = paper
background.paper.grain       = 0.07
background.paper.fibers      = 0.35
background.paper.vignette    = 0.35
background.paper.stains      = 4
background.paper.stain_color = #8B5A2B
background.paper.seed        = 11

board.style      = paper
board.line_width = 1.3
board.shadow     = false

stones.style  = ink
stones.shadow = 0.0
