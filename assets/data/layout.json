// Window layout. "icon" replaces the label: plain text, or "@name [text]" for a
// vector icon; add "label": true to show the icon with the translated label.
// vector icon (first prev next last prev2 next2 up down close plus stone_black
// stone_white gear folder save play pause chart menu check).
// Toolbar / navbar items are either {"command": "<id>"} or a
// {"type": ...} widget: separator, spacer, engine_status, theme_picker,
// move_counter. Sidebar panels are drawn in order; available panels:
// game_info, winrate_summary, winrate_graph, variation_tree, candidates, move_list,
// comment (editable), engine_log. An entry {"tabs": [...]} shows several
// panels as tabs (one visible at a time).
{
  "toolbar": [
    { "command": "file.new", "icon": "@plus", "label": true },
    { "command": "file.open", "icon": "@folder", "label": true },
    { "command": "file.save", "icon": "@save", "label": true },
    { "type": "separator" },
    { "command": "analysis.toggle", "style": "primary" },
    { "command": "analysis.candidates" },
    { "command": "analysis.ownership" },
    { "command": "view.coordinates" },
    { "type": "separator" },
    { "command": "game.ai_black", "icon": "@stone_black AI" },
    { "command": "game.ai_white", "icon": "@stone_white AI" },
    { "type": "spacer" },
    { "type": "engine_status" },
    { "command": "view.settings", "icon": "@gear" }
  ],
  "sidebar": {
    "side": "right",
    "width": 380,
    "panels": [
      "game_info",
      "winrate_summary",
      "winrate_graph",
      { "tabs": ["candidates", "move_list", "variation_tree", "comment"] }
    ]
  },
  "navbar": [
    { "command": "nav.first",          "icon": "@first" },
    { "command": "nav.back10",         "icon": "@prev2" },
    { "command": "nav.back",           "icon": "@prev" },
    { "type": "move_counter" },
    { "command": "nav.forward",        "icon": "@next" },
    { "command": "nav.forward10",      "icon": "@next2" },
    { "command": "nav.last",           "icon": "@last" },
    { "type": "separator" },
    { "command": "nav.prev_variation", "icon": "@up" },
    { "command": "nav.next_variation", "icon": "@down" },
    { "type": "spacer" },
    { "command": "game.score" },
    { "command": "move.pass" }
  ]
}
