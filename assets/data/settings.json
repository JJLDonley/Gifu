// Settings dialog. Each field binds to a config key (see the field table in
// src/app/config.c). Types:
//   bool                      on/off switch
//   number  {min,max,step,format}   stepper; range defaults to the config field's
//   choice  {options:[{value,label}] | source:"themes"|"engines", columns}
// "label" is an i18n key; "fallback" is shown when it has no translation.
{
  "sections": [
    {
      "title": "settings.appearance", "fallback": "Appearance",
      "fields": [
        { "key": "theme", "type": "choice", "source": "themes", "columns": 2,
          "label": "label.theme", "fallback": "Theme" },
        { "key": "language", "type": "choice", "columns": 3,
          "label": "settings.language", "fallback": "Language",
          "options": [
            { "value": "en",    "label": "English" },
            { "value": "zh_CN", "label": "简体中文" },
            { "value": "zh_TW", "label": "繁體中文" },
            { "value": "ja",    "label": "日本語" },
            { "value": "ko",    "label": "한국어" }
          ] },
        { "key": "ui_scale", "type": "number", "min": 0.75, "max": 2.0, "step": 0.05, "format": "%.2f×",
          "label": "settings.ui_scale", "fallback": "Interface scale" }
      ]
    },
    {
      "title": "settings.engine", "fallback": "Engine",
      "fields": [
        { "key": "engine", "type": "choice", "source": "engines", "columns": 1,
          "label": "settings.engine_profile", "fallback": "Engine profile" },
        { "key": "rules", "type": "choice", "columns": 3,
          "label": "label.rules", "fallback": "Rules",
          "options": [
            { "value": "chinese",      "label": "Chinese" },
            { "value": "japanese",     "label": "Japanese" },
            { "value": "korean",       "label": "Korean" },
            { "value": "aga",          "label": "AGA" },
            { "value": "new-zealand",  "label": "New Zealand" },
            { "value": "tromp-taylor", "label": "Tromp-Taylor" }
          ] },
        { "key": "ai.seconds_per_move", "type": "number", "step": 0.5, "max": 60, "format": "%.1f s",
          "label": "settings.ai_time", "fallback": "Engine time per move" }
      ]
    },
    {
      "title": "settings.analysis", "fallback": "Analysis",
      "fields": [
        { "key": "analysis.on_start", "type": "bool", "label": "settings.analyze_on_start", "fallback": "Analyze on start" },
        { "key": "analysis.show_candidates", "type": "bool", "label": "command.analysis.candidates", "fallback": "Candidates" },
        { "key": "analysis.show_ownership", "type": "bool", "label": "command.analysis.ownership", "fallback": "Territory" },
        { "key": "analysis.max_candidates", "type": "number", "step": 1, "format": "%.0f",
          "label": "settings.max_candidates", "fallback": "Candidates shown" },
        { "key": "analysis.interval_cs", "type": "number", "step": 5, "format": "%.0f cs",
          "label": "settings.interval", "fallback": "Update interval" }
      ]
    },
    {
      "title": "settings.board", "fallback": "Board",
      "fields": [
        { "key": "board.show_coordinates", "type": "bool", "label": "command.view.coordinates", "fallback": "Coordinates" },
        { "key": "board.show_move_numbers", "type": "bool", "label": "command.view.move_numbers", "fallback": "Move numbers" }
      ]
    }
  ]
}
