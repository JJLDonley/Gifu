# Engine profiles: "<id>.<field> = value". Fields: name kind program model config
# working_dir analysis_config human_model human_required arg (repeat per argument) platforms (comma list). Variables: ${root}
# (install root), ${exe_dir}, ${platform} (windows|linux|macos), ${exe} (".exe" on
# Windows). A model that is a directory picks the most recently installed network in it.
# Add or override profiles in <config_dir>/engines.kv.

katago-opencl.name = KataGo · OpenCL
katago-opencl.kind = katago-gtp
katago-opencl.program = ${root}/katago/${platform}-opencl/katago${exe}
katago-opencl.model = ${root}/katago/networks
katago-opencl.config = ${root}/katago/${platform}-opencl/default_gtp.cfg
katago-opencl.analysis_config = ${root}/katago/${platform}-opencl/analysis_example.cfg
katago-opencl.human_model = ${root}/katago/networks/human

katago-cpu.name = KataGo · CPU (Eigen AVX2)
katago-cpu.kind = katago-gtp
katago-cpu.platforms = linux
katago-cpu.program = ${root}/katago/linux-eigenavx2/katago
katago-cpu.model = ${root}/katago/networks
katago-cpu.config = ${root}/katago/linux-eigenavx2/default_gtp.cfg
katago-cpu.analysis_config = ${root}/katago/linux-eigenavx2/analysis_example.cfg
katago-cpu.human_model = ${root}/katago/networks/human

# human_model is loaded when the network is installed (Human moves overlay, rank
# estimate) without changing KataGo's own search. The Human style profile also
# *plays* like a human of the rank chosen in Settings (KataGo's human example cfg).
katago-human.name = KataGo · Human style (OpenCL)
katago-human.kind = katago-gtp
katago-human.program = ${root}/katago/${platform}-opencl/katago${exe}
katago-human.model = ${root}/katago/networks
katago-human.human_model = ${root}/katago/networks/human
katago-human.human_required = true
katago-human.config = ${root}/katago/${platform}-opencl/gtp_human5k_example.cfg

# The original Leela (Gian-Carlo Pascutto, 2017), an opponent to play against
# (Engine -> Download engines installs it; Settings -> AI play picks it). It
# plays Chinese rules and thinks for the AI time per move; it does not analyse.
leela.name = Leela 0.11
leela.kind = gtp
leela.program = ${root}/katago/leela/leela${exe}
leela.arg = --gtp
leela.arg = --noponder

leela-opencl.name = Leela 0.11 · OpenCL
leela-opencl.kind = gtp
leela-opencl.program = ${root}/katago/leela/leela-opencl${exe}
leela-opencl.arg = --gtp
leela-opencl.arg = --noponder

# Remote engine over SSH (key-based login: there is no terminal for a password
# prompt). Program, model and config are paths on the remote machine. Put your
# own version in <config_dir>/engines.kv.
#   remote.name = KataGo on gpu-box
#   remote.launcher = ssh -T user@gpu-box
#   remote.program = /opt/katago/katago
#   remote.model = /opt/katago/model.bin.gz
#   remote.config = /opt/katago/default_gtp.cfg
#   remote.analysis_config = /opt/katago/analysis_example.cfg
