// Key bindings: "key" is a chord ("Ctrl+Shift+S", "Right", "Space", "F12"),
// "command" is a registered command id. Users override these in config.json
// under "keymap": { "bindings": [...] } (later bindings win).
{
  "bindings": [
    { "key": "Left",         "command": "nav.back" },
    { "key": "Right",        "command": "nav.forward" },
    { "key": "Up",           "command": "nav.back" },
    { "key": "Down",         "command": "nav.forward" },
    { "key": "Shift+Left",   "command": "nav.back10" },
    { "key": "Shift+Right",  "command": "nav.forward10" },
    { "key": "Home",         "command": "nav.first" },
    { "key": "End",          "command": "nav.last" },
    { "key": "LeftBracket",  "command": "nav.prev_variation" },
    { "key": "RightBracket", "command": "nav.next_variation" },
    { "key": "Ctrl+Up",      "command": "nav.prev_variation" },
    { "key": "Ctrl+Down",    "command": "nav.next_variation" },
    { "key": "Space",        "command": "analysis.toggle" },
    { "key": "Enter",        "command": "analysis.play_best" },
    { "key": "O",            "command": "analysis.ownership" },
    { "key": "K",            "command": "analysis.candidates" },
    { "key": "P",            "command": "move.pass" },
    { "key": "Delete",       "command": "move.delete" },
    { "key": "C",            "command": "view.coordinates" },
    { "key": "T",            "command": "view.next_theme" },
    { "key": "Ctrl+Equal",   "command": "view.zoom_in" },
    { "key": "Ctrl+Minus",   "command": "view.zoom_out" },
    { "key": "Ctrl+N",       "command": "file.new" },
    { "key": "Ctrl+O",       "command": "file.open" },
    { "key": "Ctrl+S",       "command": "file.save" },
    { "key": "Ctrl+Shift+S", "command": "file.save_as" },
    { "key": "Ctrl+R",       "command": "engine.restart" },
    { "key": "N",            "command": "view.move_numbers" },
    { "key": "G",            "command": "game.ai_move" },
    { "key": "Ctrl+Comma",   "command": "view.settings" },
    { "key": "F12",          "command": "view.debug" }
  ]
}
